NODE_ENV=development
PORT=5000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nixa_music
DB_USER=postgres
DB_PASSWORD=replace-with-db-password
DB_POOL_MAX=10

JSON_BODY_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nixa Music <no-reply@nixamusic.com>
SMTP_SECURE=false
